# Selecciona el proveedor: grok, kimi, mimo (también acepta alias como "mimo-v2.5-pro")
AI_PROVIDER=grok

# Formato de salida para artículos
OUTPUT_FORMAT=mdx

# Directorios (pueden ser relativos o absolutos)
PROMPTS_DIR=./prompts
OUTPUT_DIR=./outputs
ANALYSIS_OUT_DIR=./out
INFO_DIR=./informacion-txt
FORMATTER_DIR=./ejemplo-fromater

# Usar frontmatter real del proyecto (recomendado si generas para Astro u otro CMS)
USE_PROJECT_FRONTMATTER=true
# Ruta al directorio donde están los posts existentes (para copiar SOLO el frontmatter)
BLOG_CONTENT_DIR=./src/content/blog

# Timeout global (ms) para llamadas a la IA
AI_TIMEOUT_MS=300000

# Overrides por función (opcional)
# Valores posibles para AI_PROVIDER_*: grok | kimi | mimo (o alias como "mimo-v2.5-pro")
# AI_MODEL_* cambia el "model" que se envía al proveedor seleccionado
AI_PROVIDER_ANALYSIS=grok
AI_MODEL_ANALYSIS=
AI_PROVIDER_SOURCE=mimo
AI_MODEL_SOURCE=mimo-v2.5-pro
AI_PROVIDER_GENERATE=mimo
AI_MODEL_GENERATE=mimo-v2.5-pro

# Grok API (x.ai)
GROK_API_KEY=tu_key
GROK_MODEL=grok-beta
GROK_TEMPERATURE=1.0
GROK_MAX_TOKENS=50000

# Kimi API (moonshot)
KIMI_API_KEY=tu_key
KIMI_MODEL=kimi-k2.5
KIMI_TEMPERATURE=1.0
KIMI_MAX_TOKENS=50000

# Mimo/Xiaomi API
MIMO_API_KEY=tu_key
MIMO_MODEL=MiMo-V2.5
MIMO_TEMPERATURE=1.0
MIMO_MAX_TOKENS=50000
